+/** Single-quote a value for /system/bin/sh (KernelSU/Magisk/APatch su -c). */
+private fun shQuote(value: String): String = "'" + value.replace("'", "'\\''") + "'"
+
+/**
+ * `su -c` receives one shell line: export the launch environment, then exec the original
+ * PRoot argv. Keeps the guest environment identical to a non-root start.
+ */
+private fun rootWrapped(argv: List<String>, env: Map<String, String>): List<String> {
+    val exports = env.entries.joinToString("; ") { (k, v) -> "export $k=${shQuote(v)}" }
+    val command = argv.joinToString(" ") { shQuote(it) }
+    return listOf("su", "-c", "$exports; exec $command")
+}
